{
  "name": "classroom-attendance", "main": "dist/server/index.js", "compatibility_date": "2026-10-01",
  "vars": {"LOCAL_DEMO":"true"},
  "assets": {"directory": "dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding":"DB","database_name":"classroom","database_id":"local-classroom","migrations_dir":"migrations"}]
}
